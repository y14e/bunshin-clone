{
  "name": "bunshin-clone",
  "version": "1.9.2",
  "description": "High-performance deep clone utility with descriptor support",
  "keywords": [
    "array",
    "buffer",
    "circular-reference",
    "clone",
    "clone-array",
    "clone-array-deep",
    "clone-buffer",
    "clone-date",
    "clone-deep",
    "clone-map",
    "clone-object",
    "clone-object-deep",
    "clone-regexp",
    "clone-set",
    "copy",
    "copy-deep",
    "date",
    "deep",
    "deep-clone",
    "deep-copy",
    "descriptor",
    "map",
    "object",
    "property-descriptor",
    "regexp",
    "set",
    "structured-clone",
    "typescript"
  ],
  "homepage": "https://github.com/y14e/bunshin-clone#readme",
  "bugs": {
    "url": "https://github.com/y14e/bunshin-clone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y14e/bunshin-clone.git"
  },
  "license": "MIT",
  "author": "Yusuke Kamiyamane",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "bench": "bun tsup & npm run bench:install & npm run bench:run & npm run bench:uninstall",
    "bench:install": "npm i bunshin-clone-npm@npm:bunshin-clone lodash.clonedeep @types/lodash.clonedeep tinybench",
    "bench:run": "node ./benchmark/run.ts",
    "bench:uninstall": "npm un bunshin-clone-npm lodash.clonedeep @types/lodash.clonedeep tinybench",
    "build": "tsup",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "bun test"
  },
  "devDependencies": {
    "bun-types": "latest",
    "tsup": "^8.0.0",
    "type-fest": "^5.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild": true
  }
}
